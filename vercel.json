{
    "rewrites": [
      {
        "source": "/me/:numeroTelephoneClient/track",
        "destination": "/index.html"
      },
      {
        "source": "/track/:phone",
        "destination": "/index.html"
      },
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ],
    "builds": [
      {
        "src": "package.json",
        "use": "@vercel/static-build",
        "config": {
          "buildCommand": "npm install --force && npm run build"
        }
      }
    ]
  }